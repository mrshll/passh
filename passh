#!/usr/bin/env python3
"""passh — the 1Password CLI, run where the biometrics are.

On the Mac this just calls the local `op`.

On a remote machine there is no usable biometric prompt: if the 1Password app
is installed there it throws its auth dialog onto a GUI session nobody is
watching. So passh sends the call back to your laptop through a tunnel carried
by the SSH session you already have open, and Touch ID appears in front of you.

That tunnel only exists while you are connected, so the remote machine's access
to your vaults ends when your session does. Nothing durable is stored here.
"""

from __future__ import annotations

import base64
import json
import os
import platform
import re
import secrets
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

PORT = int(os.environ.get("PASSH_PORT", "18340"))
ENDPOINT = f"http://127.0.0.1:{PORT}/op"
FIELDS_ENDPOINT = f"http://127.0.0.1:{PORT}/fields"
TOKEN_PATH = Path(os.environ.get("PASSH_TOKEN_FILE", Path.home() / ".config" / "passh" / "token"))
LOCAL_OP = os.environ.get("PASSH_OP", "op")

BLOCKED = {"service-account", "signin", "signout", "update", "completion"}
BLOCKED_PAIRS = {("account", "add"), ("account", "forget")}

# Kept in step with passhd's copies by hand: these are two standalone scripts,
# and the daemon must not depend on the client's version of either anyway.
FIELD_KEYS = ("id", "label", "type", "purpose")


def parse_ref(ref: str) -> tuple[str, str]:
    """Split op://VAULT/ITEM, or raise ValueError."""
    if not ref.startswith("op://"):
        raise ValueError("expected an op://VAULT/ITEM reference")
    parts = ref[len("op://"):].split("/")
    if len(parts) != 2 or not all(parts):
        raise ValueError("expected op://VAULT/ITEM, with no field component")
    for part in parts:
        if part.startswith("-") or any(ch < " " for ch in part):
            raise ValueError(f"invalid path segment {part!r}")
    return parts[0], parts[1]


def sanitize_fields(item: dict) -> list[dict]:
    """Reduce an item to its shape: labels, types, sections. Never values."""
    section_labels = {s.get("id"): s.get("label") for s in item.get("sections") or []}
    fields = []
    for field in item.get("fields") or []:
        meta = {key: field[key] for key in FIELD_KEYS if field.get(key)}
        section = field.get("section") or {}
        name = section.get("label") or section_labels.get(section.get("id")) or section.get("id")
        if name:
            meta["section"] = name
        fields.append(meta)
    return fields


ENV_KEY = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
# A reference: no braces except op's own ${VAR}, no control characters, no
# undecodable bytes. Spaces are allowed; item and field names have them.
_REF_CHAR = r"[^{}\x00-\x1f\x7f\udc80-\udcff]"
REF = re.compile(rf"op://(?:{_REF_CHAR}|\$\{{{_REF_CHAR}*\}})+")
ENCLOSED_REF = re.compile(rf"\{{\{{[ \t]*({REF.pattern}?)[ \t]*\}}\}}")
# op:// at the end of a longer word (shop://) is some other scheme, not a reference.
BARE_REF = re.compile(r"(?<![A-Za-z0-9])op://")
DQ_ESCAPES = {"n": "\n", "r": "\r", "t": "\t", '"': '"', "\\": "\\"}


class EnvFileError(ValueError):
    """A problem with an env file. Messages name lines and keys, never values."""


def parse_env_file(text: str) -> list[tuple[int, str, str]]:
    """Parse a dotenv template into (line, key, value), before anything is resolved.

    Quoting belongs to the template the user wrote. Resolved secrets are spliced
    in afterwards and never parsed, so their quotes, newlines and '=' are kept.
    """
    text = text.replace("\r\n", "\n")
    entries = []
    pos = 0
    while pos < len(text):
        lineno = text.count("\n", 0, pos) + 1
        eol = text.find("\n", pos)
        if eol == -1:
            eol = len(text)
        raw = text[pos:eol]
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            pos = eol + 1
            continue

        body = stripped
        if body.startswith(("export ", "export\t")):
            body = body[len("export"):].lstrip()
        key, sep, _ = body.partition("=")
        key = key.strip()
        if not sep:
            raise EnvFileError(f"line {lineno}: expected KEY=VALUE")
        if not ENV_KEY.fullmatch(key):
            raise EnvFileError(f"line {lineno}: invalid variable name")
        after_eq = start = pos + raw.index("=") + 1
        while start < eol and text[start] in " \t":
            start += 1

        quote = text[start] if start < eol else ""
        if quote in ('"', "'"):
            value, close = scan_quoted(text, start + 1, quote)
            if close is None:
                raise EnvFileError(f"line {lineno} ({key}): unterminated {quote} quote")
            eol = text.find("\n", close)
            if eol == -1:
                eol = len(text)
            tail = text[close + 1:eol].strip()
            if tail and not tail.startswith("#"):
                raise EnvFileError(f"line {lineno} ({key}): unexpected text after the closing quote")
        else:
            value = text[after_eq:eol]
            comment = re.search(r"[ \t]#", value)
            if comment:
                value = value[:comment.start()]
            value = value.strip()
        entries.append((lineno, key, value))
        pos = eol + 1
    return entries


def scan_quoted(text: str, i: int, quote: str) -> tuple[str, int | None]:
    """Read a quoted value starting after its opening quote, across lines.

    Single quotes are literal. Double quotes understand the escapes in
    DQ_ESCAPES; any other backslash is kept as written. Returns the value and
    the index of the closing quote, or None if it never closes.
    """
    out = []
    while i < len(text):
        ch = text[i]
        if ch == quote:
            return "".join(out), i
        if ch == "\\" and quote == '"' and i + 1 < len(text):
            nxt = text[i + 1]
            out.append(DQ_ESCAPES.get(nxt, ch + nxt))
            i += 2
            continue
        out.append(ch)
        i += 1
    return "".join(out), None


def split_refs(lineno: int, key: str, value: str) -> list[tuple[bool, str]]:
    """Split a value into (is_reference, text) parts.

    A value that starts with op:// is one whole reference, spaces and all, as
    in `op run`. Otherwise only {{ op://... }} is a reference: everything else
    is literal and stays on this machine, so op never gets a chance to expand
    $VARS in it.
    """
    if value.startswith("op://") and "{{" not in value:
        if not REF.fullmatch(value):
            raise EnvFileError(f"line {lineno} ({key}): not a valid op:// reference")
        return [(True, value)]
    parts = []
    last = 0
    for match in ENCLOSED_REF.finditer(value):
        parts.append((False, value[last:match.start()]))
        parts.append((True, match.group(1)))
        last = match.end()
    parts.append((False, value[last:]))
    for is_ref, text in parts:
        if not is_ref and "\0" in text:
            raise EnvFileError(f"line {lineno} ({key}): the value contains a NUL byte")
        if not is_ref and BARE_REF.search(text):
            raise EnvFileError(
                f"line {lineno} ({key}): an op:// reference inside other text must be"
                " written {{ op://... }}"
            )
    return [(is_ref, text) for is_ref, text in parts if is_ref or text]


# op's output on failure is never shown by `run`: it is not ours to vouch for
# and could quote something it resolved. These substrings only pick one of the
# fixed hints below; none of op's text is ever printed.
INJECT_FAILURE_HINTS = (
    (b"not currently signed in",
     ("op is not signed in on the machine running it. Check with `passh doctor`;\n"
      "       in no-tunnel fallback, run: eval $(op signin)")),
    (b"authorization timeout",
     "1Password was not unlocked in time. Approve the prompt on the laptop and retry."),
)
INJECT_FAILURE_DEFAULT = (
    "Check the link and sign-in with `passh doctor`, and each item with\n"
    "       `passh fields op://VAULT/ITEM`."
)


def report_inject_failure(rc: int, err: bytes, command: str) -> None:
    print(f"passh: op inject failed (exit {rc}); not running {command}.", file=sys.stderr)
    print("       op's own output is not shown: it can contain secret values.", file=sys.stderr)
    lowered = err.lower()
    hint = next((h for needle, h in INJECT_FAILURE_HINTS if needle in lowered), INJECT_FAILURE_DEFAULT)
    print(f"       {hint}", file=sys.stderr)


def frame_refs(refs: list[str], nonce: str) -> bytes:
    """One op inject template for every reference, each between marker lines."""
    chunks = [f"{nonce}:{i}\n{{{{ {ref} }}}}\n" for i, ref in enumerate(refs)]
    return "".join([*chunks, f"{nonce}:end\n"]).encode()


def unframe(out: bytes, count: int, nonce: str) -> list[bytes] | None:
    """Undo frame_refs on op's output, or None if it does not match exactly.

    Only the newline frame_refs added after each value is removed; whatever
    op produced for the value itself is kept byte for byte.
    """
    marker = nonce.encode()
    if out.count(marker) != count + 1:
        return None
    values = []
    pos = 0
    for i in range(count):
        head = marker + f":{i}\n".encode()
        if not out.startswith(head, pos):
            return None
        pos += len(head)
        nxt = b"\n" + marker + (f":{i + 1}\n".encode() if i + 1 < count else b":end")
        end = out.find(nxt, pos)
        if end == -1:
            return None
        values.append(out[pos:end])
        pos = end + 1
    if out[pos:] not in (marker + b":end\n", marker + b":end"):
        return None
    return values


USAGE = """passh — the 1Password CLI, run where the biometrics are.

  passh run --env-file=FILE -- CMD...   resolve op:// refs, run CMD here
  passh inject [-i FILE] [-o FILE]      resolve op:// refs in a template
  passh read op://VAULT/ITEM/FIELD      print one secret
  passh fields op://VAULT/ITEM          list field metadata; values never leave the Mac
  passh doctor                          check the link to the Mac
  passh <any other op subcommand>       forwarded verbatim

Prefer `passh run` over `passh read`: it keeps secret values out of your
terminal, your shell history, and any agent's conversation context.

If the tunnel is down (mobile SSH client, laptop asleep, tmux session
outliving its SSH session), passh falls back to op on this machine, which
asks for your 1Password password instead of Touch ID.

Env: PASSH_PORT, PASSH_OP, PASSH_TOKEN_FILE,
     PASSH_MODE=local|remote, PASSH_NO_FALLBACK=1
"""


def die(msg: str, code: int = 1) -> "NoReturn":  # noqa: F821
    print(f"passh: {msg}", file=sys.stderr)
    raise SystemExit(code)


class TunnelDown(Exception):
    """The tunnel is not answering — the laptop is unreachable right now."""


def resolve_mode() -> str:
    """'local' or 'remote'. Remote may still fall back; see op_exec."""
    forced = os.environ.get("PASSH_MODE", "").strip().lower()
    if forced in ("local", "remote"):
        return forced
    if forced:
        die(f"PASSH_MODE must be 'local' or 'remote', not {forced!r}")
    if os.environ.get("PASSH_FORCE_REMOTE"):
        return "remote"
    return "local" if platform.system() == "Darwin" else "remote"


def is_remote() -> bool:
    return resolve_mode() == "remote"


_warned = False


def warn_fallback(reason: str) -> None:
    """Say why we stopped using the tunnel — once, no matter how many calls."""
    global _warned
    if _warned:
        return
    _warned = True
    print(f"passh: no tunnel to the laptop ({reason}).", file=sys.stderr)
    print("       Falling back to op on this machine.", file=sys.stderr)
    needs_password = platform.system() != "Darwin"
    if needs_password and not sys.stdin.isatty() and not any(
        k.startswith("OP_SESSION_") for k in os.environ
    ):
        print("       This needs a password prompt and there is no terminal here,", file=sys.stderr)
        print("       so it will fail. Run `eval $(op signin)` in your shell first.", file=sys.stderr)


def check_blocked(args: list[str]) -> None:
    """Fail fast on the client. passhd enforces this too, and authoritatively."""
    positional = [a for a in args if not a.startswith("-")]
    if not positional:
        return
    name = None
    if positional[0] in BLOCKED:
        name = positional[0]
    elif len(positional) >= 2 and (positional[0], positional[1]) in BLOCKED_PAIRS:
        name = f"{positional[0]} {positional[1]}"
    if name:
        die(f"'{name}' is blocked. Run it on the Mac directly if you really mean it.")


def run_local(args: list[str], stdin: bytes | None, fallback: bool = False) -> tuple[int, bytes, bytes]:
    env = dict(os.environ)
    if fallback and platform.system() != "Darwin":
        # Without this, op on a headless box tries the desktop app and dies with
        # "cannot connect to 1Password app". Off, it asks for the password here.
        # Only on non-macOS: where the app genuinely works, let op use it.
        env["OP_BIOMETRIC_UNLOCK_ENABLED"] = "false"
    try:
        proc = subprocess.run([LOCAL_OP, *args], input=stdin, capture_output=True, env=env)
    except FileNotFoundError:
        die(f"{LOCAL_OP} not found on PATH")
    return proc.returncode, proc.stdout, proc.stderr


def op_exec(args: list[str], stdin: bytes | None = None) -> tuple[int, bytes, bytes]:
    """Run op through the tunnel, or locally if there is no tunnel to use."""
    if not is_remote():
        # No blocklist here. It exists to limit what the tunnel exposes to a
        # remote machine; locally you could just run `op` yourself, so refusing
        # would buy nothing and would block the `passh signin` you need to
        # authenticate in fallback mode.
        return run_local(args, stdin)

    check_blocked(args)
    try:
        return run_remote(args, stdin)
    except TunnelDown as exc:
        if os.environ.get("PASSH_NO_FALLBACK"):
            die(f"no tunnel to the laptop ({exc}) and PASSH_NO_FALLBACK is set")
        warn_fallback(str(exc))
        return run_local(args, stdin, fallback=True)


def post(endpoint: str, payload: dict) -> dict:
    """POST to passhd through the tunnel. Raises TunnelDown if it is not there."""
    try:
        token = TOKEN_PATH.read_text().strip()
    except OSError:
        die(
            f"no token at {TOKEN_PATH}.\n"
            "       Copy it from your laptop: scp ~/.config/passh/token THIS_HOST:.config/passh/token"
        )

    req = urllib.request.Request(
        endpoint,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json", "Authorization": f"Bearer {token}"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=180) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")
        try:
            detail = json.loads(detail).get("error", detail)
        except ValueError:
            pass
        if exc.code == 401:
            die(f"the Mac rejected our token: {detail}\n"
                "       Re-copy ~/.config/passh/token from the Mac.")
        die(f"passhd returned {exc.code}: {detail}")
    except urllib.error.URLError as exc:
        raise TunnelDown(str(exc.reason)) from exc


def run_remote(args: list[str], stdin: bytes | None) -> tuple[int, bytes, bytes]:
    body = post(ENDPOINT, {
        "args": args,
        "stdin": base64.b64encode(stdin).decode() if stdin else None,
    })
    return (
        int(body["rc"]),
        base64.b64decode(body["stdout"]),
        base64.b64decode(body["stderr"]),
    )


def passthrough(args: list[str], stdin: bytes | None = None) -> int:
    rc, out, err = op_exec(args, stdin)
    sys.stdout.flush()
    sys.stdout.buffer.write(out)
    sys.stdout.buffer.flush()
    sys.stderr.buffer.write(err)
    sys.stderr.buffer.flush()
    return rc


def cmd_run(argv: list[str]) -> int:
    """`op run` cannot be forwarded as-is — it would launch CMD on the Mac.

    So resolve the env-file over there, then exec CMD here with the values in
    the environment. Same contract as `op run`, split across the hop.
    """
    env_file = None
    pass_through: list[str] = []
    while argv:
        arg = argv[0]
        if arg.startswith("--env-file="):
            env_file = arg.split("=", 1)[1]
            argv.pop(0)
        elif arg == "--env-file":
            if len(argv) < 2:
                die("--env-file needs a value")
            env_file = argv[1]
            del argv[:2]
        elif arg.startswith("--account="):
            pass_through.append(argv.pop(0))
        elif arg == "--account":
            if len(argv) < 2:
                die("--account needs a value")
            pass_through += argv[:2]
            del argv[:2]
        elif arg == "--no-masking":
            argv.pop(0)          # nothing is echoed back here anyway
        elif arg == "--":
            argv.pop(0)
            break
        elif arg.startswith("-"):
            die(f"unrecognised flag for 'passh run': {arg}")
        else:
            break

    if not env_file:
        die("'run' needs --env-file=FILE")
    if not argv:
        die("'run' needs a command after '--'")
    try:
        template = Path(env_file).read_bytes()
    except OSError as exc:
        die(f"cannot read env file: {exc}")

    # Parse first, resolve second: never parse text that has secrets in it.
    try:
        entries = [(key, split_refs(lineno, key, value))
                   for lineno, key, value in parse_env_file(os.fsdecode(template))]
    except EnvFileError as exc:
        die(f"{env_file}: {exc}")

    refs = list(dict.fromkeys(text for _, parts in entries for is_ref, text in parts if is_ref))
    resolved: dict[str, str] = {}
    if refs:
        nonce = secrets.token_hex(16)
        rc, out, err = op_exec(["inject", *pass_through], stdin=frame_refs(refs, nonce))
        if rc != 0:
            report_inject_failure(rc, err, argv[0])
            return rc
        values = unframe(out, len(refs), nonce)
        if values is None:
            die(f"could not map op inject's output back to the keys in {env_file}; not running {argv[0]}")
        resolved = {ref: os.fsdecode(value) for ref, value in zip(refs, values)}

    env = dict(os.environ)
    for key, parts in entries:
        value = "".join(resolved[text] if is_ref else text for is_ref, text in parts)
        if "\0" in value:
            die(f"{key}: the value contains a NUL byte, which cannot be passed in the environment")
        env[key] = value

    # execve passes the environment out of band, so resolved values never
    # appear in any process's argv.
    try:
        os.execvpe(argv[0], argv, env)
    except OSError as exc:
        die(f"cannot run {argv[0]}: {exc}", 127)


def cmd_inject(argv: list[str]) -> int:
    in_file = out_file = None
    pass_through: list[str] = []
    while argv:
        arg = argv[0]
        if arg in ("-i", "--in-file"):
            if len(argv) < 2:
                die(f"{arg} needs a value")
            in_file = argv[1]
            del argv[:2]
        elif arg.startswith("--in-file="):
            in_file = argv.pop(0).split("=", 1)[1]
        elif arg in ("-o", "--out-file"):
            if len(argv) < 2:
                die(f"{arg} needs a value")
            out_file = argv[1]
            del argv[:2]
        elif arg.startswith("--out-file="):
            out_file = argv.pop(0).split("=", 1)[1]
        elif arg in ("-f", "--force"):
            argv.pop(0)
        else:
            pass_through.append(argv.pop(0))

    if in_file:
        try:
            content = Path(in_file).read_bytes()
        except OSError as exc:
            die(f"cannot read input file: {exc}")
    else:
        content = sys.stdin.buffer.read()
    if not content:
        die("'inject' got empty input")

    rc, out, err = op_exec(["inject", *pass_through], stdin=content)
    sys.stderr.buffer.write(err)
    if rc != 0:
        return rc

    # -o is handled here: the output belongs on this machine, not the Mac.
    if out_file:
        path = Path(out_file)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as fh:
            fh.write(out)
    else:
        sys.stdout.buffer.write(out)
    return 0


def fields_local(ref: str, account: str | None, fallback: bool = False) -> tuple[int, list[dict], bytes]:
    """Fetch the item with the op on this machine and strip it in process."""
    vault, item = parse_ref(ref)
    args = ["item", "get", item, "--vault", vault, "--format", "json"]
    if account:
        args += ["--account", account]
    rc, out, err = run_local(args, None, fallback=fallback)
    if rc != 0:
        return rc, [], err
    try:
        return 0, sanitize_fields(json.loads(out)), b""
    except ValueError as exc:
        die(f"could not parse op's output: {exc}")


def fields_remote(ref: str, account: str | None) -> tuple[int, list[dict], bytes]:
    """Ask the Mac for the item's shape. The values stay over there."""
    body = post(FIELDS_ENDPOINT, {"ref": ref, "account": account})
    rc = int(body.get("rc", 0))
    if rc != 0:
        return rc, [], base64.b64decode(body.get("stderr") or "")
    return 0, body.get("fields") or [], b""


def print_fields(fields: list[dict]) -> None:
    if not fields:
        print("(no fields)")
        return
    columns = [("label", "LABEL"), ("type", "TYPE"), ("purpose", "PURPOSE"), ("section", "SECTION")]
    columns = [c for c in columns if any(f.get(c[0]) for f in fields)]
    rows = [[str(f.get(key, "")) for key, _ in columns] for f in fields]
    widths = [max(len(head), *(len(row[i]) for row in rows)) for i, (_, head) in enumerate(columns)]
    for row in [[head for _, head in columns], *rows]:
        print("  ".join(cell.ljust(w) for cell, w in zip(row, widths)).rstrip())


def cmd_fields(argv: list[str]) -> int:
    """List an item's field labels and types without fetching its values.

    passhd does the stripping on the Mac, so the values are never put on the
    tunnel at all. Pulling the whole item over here and filtering afterwards
    would defeat the point.
    """
    ref = account = None
    as_json = False
    while argv:
        arg = argv.pop(0)
        if arg == "--json":
            as_json = True
        elif arg == "--account":
            if not argv:
                die("--account needs a value")
            account = argv.pop(0)
        elif arg.startswith("--account="):
            account = arg.split("=", 1)[1]
        elif arg.startswith("-"):
            die(f"unrecognised flag for 'passh fields': {arg}")
        elif ref is None:
            ref = arg
        else:
            die("'fields' takes a single op://VAULT/ITEM reference")

    if not ref:
        die("'fields' needs an op://VAULT/ITEM reference")
    try:
        parse_ref(ref)
    except ValueError as exc:
        die(f"bad reference: {exc}")

    if not is_remote():
        rc, fields, err = fields_local(ref, account)
    else:
        try:
            rc, fields, err = fields_remote(ref, account)
        except TunnelDown as exc:
            if os.environ.get("PASSH_NO_FALLBACK"):
                die(f"no tunnel to the laptop ({exc}) and PASSH_NO_FALLBACK is set")
            warn_fallback(str(exc))
            # Worth spelling out: the filtering happens wherever op runs, so
            # without the tunnel the values are fetched onto this machine. They
            # are dropped and never printed, but the Mac boundary is gone.
            print("       'fields' normally filters on the Mac. With no tunnel the", file=sys.stderr)
            print("       values are fetched here instead — discarded, never printed,", file=sys.stderr)
            print("       but they do reach this machine.", file=sys.stderr)
            rc, fields, err = fields_local(ref, account, fallback=True)

    if rc != 0:
        sys.stderr.buffer.write(err)
        return rc
    if as_json:
        print(json.dumps({"fields": fields}))
    else:
        print_fields(fields)
    return 0


def cmd_doctor() -> int:
    mode = resolve_mode()
    if mode == "local":
        where = "macOS" if platform.system() == "Darwin" else "forced by PASSH_MODE"
        print(f"mode:     local ({where}) — using the op on this machine")
        print(f"op:       {LOCAL_OP}")
        return passthrough(["account", "list"])

    print(f"mode:     remote -> passhd on 127.0.0.1:{PORT} (tunnelled to the laptop)")
    print(f"token:    {TOKEN_PATH} {'found' if TOKEN_PATH.exists() else 'MISSING'}")

    try:
        rc, out, err = run_remote(["--version"], None)
    except TunnelDown as exc:
        print(f"tunnel:   DOWN ({exc})")
        print(f"          Expected an SSH session from the laptop carrying:")
        print(f"              RemoteForward {PORT} 127.0.0.1:{PORT}")
        print()
        if os.environ.get("PASSH_NO_FALLBACK"):
            print("fallback: disabled by PASSH_NO_FALLBACK")
            return 1
        print("fallback: local op on this machine")
        rc, out, err = run_local(["account", "list"], None, fallback=True)
        sys.stdout.flush()
        sys.stdout.buffer.write(out)
        if rc != 0:
            sys.stderr.buffer.write(err)
            print("          Not signed in. Run: eval $(op signin)")
        elif not any(k.startswith("OP_SESSION_") for k in os.environ):
            print("          Accounts are configured; each call will ask for your")
            print("          password until you run: eval $(op signin)")
        return rc

    print("tunnel:   up")
    if rc != 0:
        sys.stderr.buffer.write(err)
        return rc
    print(f"op:       {out.decode().strip()} (on the laptop)")
    print("accounts:")
    rc, out, err = op_exec(["account", "list"])
    sys.stdout.flush()
    sys.stdout.buffer.write(out)
    if rc != 0:
        sys.stderr.buffer.write(err)
        print("          Reachable, but not authorised — unlock 1Password on the laptop.")
    return rc


def main() -> int:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "run":
        return cmd_run(rest)
    if cmd == "inject":
        return cmd_inject(rest)
    if cmd == "fields":
        return cmd_fields(rest)
    if cmd == "doctor":
        return cmd_doctor()
    # Deliberately no stdin here: reading it would block forever when passh is
    # called from a script or an agent, where stdin is an open pipe nobody
    # closes. `inject` and `run` read their own input explicitly.
    return passthrough(argv, None)


if __name__ == "__main__":
    sys.exit(main())
